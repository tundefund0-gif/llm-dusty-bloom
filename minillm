}

# ---- Text Generation via API Proxy (CLI mode) ----------------------------

generate_via_api() {
    local prompt="$*"

    if [ -z "$API_URL" ]; then
        error "MINILLM_API_URL not set"
        exit 1
    fi

    info "Using API: ${API_URL}"
    info "Generating..."

    local payload
    if echo "$API_URL" | grep -qi "chat"; then
        payload=$(cat <<JSON
{
  "model": "gpt-3.5-turbo",
  "messages": [{"role": "user", "content": $(printf '%s' "$prompt" | python3 -c "import json,sys; print(json.dumps(sys.stdin.read()))")}],
  "max_tokens": 256,
  "temperature": 0.7
}
JSON
        )
    else
        payload=$(cat <<JSON
{
  "prompt": $(printf '%s' "$prompt" | python3 -c "import json,sys; print(json.dumps(sys.stdin.read()))"),
  "max_tokens": 256,
  "temperature": 0.7
}
JSON
        )
    fi

    local auth_header=""
    if [ -n "$API_KEY" ]; then
        auth_header="-H \"Authorization: Bearer ${API_KEY}\""
    fi

    local response
    response=$(eval curl -s "$API_URL" \
        -H "Content-Type: application/json" \
        $auth_header \
        -d "$payload" 2>/dev/null)

    local text=""
    text=$(echo "$response" | python3 -c "
import json, sys
try:
    d = json.load(sys.stdin)
    if 'response' in d:
        print(d['response'])
    elif 'choices' in d and len(d['choices']) > 0:
        c = d['choices'][0]
        if 'message' in c and 'content' in c['message']:
            print(c['message']['content'])
        elif 'text' in c:
            print(c['text'])
except:
    pass" 2>/dev/null)

    if [ -n "$text" ]; then
        echo "$text"
    else
        warn "No response or error:"
        echo "$response" | head -c 500
        echo ""
    fi
}

# ---- Text Generation (Local) ----------------------------------------------

generate() {
    local model="$1"
    local prompt=""
    local max_tokens=256
    local temperature=0.7
    shift

    # Parse remaining args for prompt and flags
    while [ $# -gt 0 ]; do
        case "$1" in
            --temp)
                temperature="$2"; shift 2 ;;
            --max-tokens|--max_tokens)
                max_tokens="$2"; shift 2 ;;
            --*)
                shift ;;
            *)
                if [ -z "$prompt" ]; then
                    prompt="$1"
                else
                    prompt="$prompt $1"
                fi
                shift ;;
        esac
    done

    if [ ! -f "$model" ]; then
        error "Model not found: $model"
        exit 1
    fi

    ensure_engine

    info "Running inference (temp=${temperature}, max_tokens=${max_tokens})..."
    "$BINARY" "$model" "$prompt" --temp "$temperature" --max-tokens "$max_tokens" 2>/dev/null
    echo ""
}

# ---- Chat Mode ------------------------------------------------------------

chat_mode() {
    local model="$1"

    if [ ! -f "$model" ]; then
        error "Model not found: $model"
        exit 1
    fi

    ensure_engine

    header "Interactive Chat"
    info "Model: $model"
    info "Ctrl+C or type '/exit' to quit"
    echo ""

    local server_pid=""
    local tmpdir
    tmpdir=$(mktemp -d)

    cleanup() {
        if [ -n "$server_pid" ]; then
            kill "$server_pid" 2>/dev/null || true
        fi
        rm -rf "$tmpdir"
        trap - INT TERM EXIT
        echo ""
        info "Chat ended"
    }
    trap cleanup INT TERM EXIT

    # Start server in background with configured port
    MINILLM_PORT="$PORT" "$BINARY" "$model" > /dev/null 2> "$tmpdir/server.log" &
    server_pid=$!

    # Wait for server to start
    for i in $(seq 1 30); do
        if curl -s "http://localhost:${PORT}/api/version" > /dev/null 2>&1; then
            break
        fi
        if ! kill -0 "$server_pid" 2>/dev/null; then
            error "Server failed to start"
            cat "$tmpdir/server.log"
            exit 1
        fi
        sleep 1
    done

    ok "Server ready on http://localhost:${PORT}"
    echo ""

    while true; do
        printf "${CYAN}>>>${NC} "
        read -r input

        if [ "$input" = "/exit" ] || [ "$input" = "/quit" ]; then
            break
        fi

        if [ -z "$input" ]; then
            continue
        fi

        if [ "$input" = "/help" ]; then
            echo "Commands: /exit, /quit, /help"
            continue
        fi

        local escaped_input
        escaped_input=$(printf '%s' "$input" | sed 's/"/\\"/g')

        printf "${YELLOW}...${NC}\n"

        local response
        response=$(curl -s "http://localhost:${PORT}/api/generate" \
            -d "{\"prompt\":\"${escaped_input}\",\"max_tokens\":512,\"temperature\":0.7}")

        local reply
        reply=$(echo "$response" | sed 's/.*"response":"\([^"]*\)".*/\1/' | sed 's/\\n/\n/g' | sed 's/\\"/"/g' | sed 's/\\\\/\\/g')

        if [ -n "$reply" ]; then
            printf "${GREEN}%s${NC}\n" "$reply"
        else
            warn "No response (model may not have output weights or tokenizer)"
        fi
        echo ""
    done

    cleanup
}

# ---- API Proxy Server (NVIDIA/OpenAI/etc) -----------------------------------

api_proxy_server() {
    header "Starting API Proxy Server"
    info "Backend: ${API_URL}"
    info "Port:    ${PORT}"
    echo ""
    info "Requests to /api/generate are forwarded to the external API"
    echo ""

    local tmpfile
    tmpfile=$(mktemp)

    cat > "$tmpfile" << 'PYEOF'
import http.server, json, urllib.request, sys, os, signal

class ProxyHandler(http.server.BaseHTTPRequestHandler):
    def do_OPTIONS(self):
        self.send_response(200)
        self.send_header('Access-Control-Allow-Origin', '*')
        self.send_header('Access-Control-Allow-Methods', 'POST, GET, OPTIONS')
        self.send_header('Access-Control-Allow-Headers', 'Content-Type')
        self.end_headers()

    def do_POST(self):
        if '/api/generate' in self.path:
            body = self.rfile.read(int(self.headers.get('Content-Length', 0)))
            try:
                data = json.loads(body)
            except:
                self.json_response(400, {'error': 'bad json'})
                return

            prompt = data.get('prompt', '')
            max_tokens = data.get('max_tokens', 256)
            temperature = data.get('temperature', 0.7)

            api_url = os.environ.get('MINILLM_API_URL', '')
            api_key = os.environ.get('MINILLM_API_KEY', '')

            if not api_url:
                self.json_response(500, {'error': 'MINILLM_API_URL not set'})
                return

            headers = {'Content-Type': 'application/json'}
            if api_key:
                headers['Authorization'] = f'Bearer {api_key}'

            if 'openai.azure.com' in api_url:
                payload = json.dumps({
                    'messages': [{'role': 'user', 'content': prompt}],
                    'max_tokens': max_tokens,
                    'temperature': temperature
                }).encode()
            elif '/v1/chat/completions' in api_url:
                payload = json.dumps({
                    'model': data.get('model', 'gpt-3.5-turbo'),
                    'messages': [{'role': 'user', 'content': prompt}],
                    'max_tokens': max_tokens,
                    'temperature': temperature
                }).encode()
            elif '/v1/completions' in api_url:
                payload = json.dumps({
                    'prompt': prompt,
                    'max_tokens': max_tokens,
                    'temperature': temperature
                }).encode()
            else:
                payload = json.dumps({
                    'prompt': prompt,
                    'max_tokens': max_tokens,
                    'temperature': temperature
                }).encode()

            try:
                req = urllib.request.Request(api_url, data=payload, headers=headers, method='POST')
                with urllib.request.urlopen(req, timeout=120) as resp:
                    result = json.loads(resp.read())
                    response_text = ''
                    if 'response' in result:
                        response_text = result['response']
                    elif 'choices' in result and len(result['choices']) > 0:
                        c = result['choices'][0]
                        if 'message' in c and 'content' in c['message']:
                            response_text = c['message']['content']
                        elif 'text' in c:
                            response_text = c['text']
                    self.json_response(200, {'response': response_text, 'model': 'api-proxy', 'done': True})
            except Exception as e:
                self.json_response(502, {'error': str(e)})
        else:
            self.json_response(404, {'error': 'not found'})

    def do_GET(self):
        if '/api/tags' in self.path:
            self.json_response(200, {'models': [{'name': 'api-proxy', 'size': 0}]})
        elif '/api/version' in self.path:
            self.json_response(200, {'version': '0.3.0'})
        else:
            self.json_response(404, {'error': 'not found'})

    def json_response(self, code, data):
        self.send_response(code)
        self.send_header('Content-Type', 'application/json')
        self.send_header('Access-Control-Allow-Origin', '*')
        self.end_headers()
        self.wfile.write(json.dumps(data).encode())

    def log_message(self, fmt, *args):
        sys.stderr.write('[API Proxy] %s\n' % (fmt % args))

def shutdown(sig, frame):
    sys.exit(0)

signal.signal(signal.SIGTERM, shutdown)
signal.signal(signal.SIGINT, shutdown)

port = int(os.environ.get('MINILLM_PORT', '8080'))
server = http.server.HTTPServer(('0.0.0.0', port), ProxyHandler)
sys.stderr.write(f'API Proxy running on port {port}\n')
sys.stderr.flush()
server.serve_forever()
PYEOF

    python3 "$tmpfile"
    rm -f "$tmpfile"
}

