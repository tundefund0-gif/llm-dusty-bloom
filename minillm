#!/usr/bin/env bash
# =============================================================================
# minillm - Single-file LLM Inference Engine
# Version: 0.4.0
# License: MIT
#
# A self-contained LLM inference engine. Extracts, builds, and runs
# a compiled inference engine from an embedded C source with proper
# GGUF tokenizer support (produces real text, not token IDs).
#
# Usage:
#   ./minillm <model.gguf> [prompt]             Generate text
#   ./minillm <model.gguf>                      Start API server
#   ./minillm chat <model>                      Interactive chat
#   ./minillm download <url> [name]             Download model
#   ./minillm demo                              Download TinyLlama demo model
#   ./minillm list                              List cached models
#   ./minillm remove <name>                     Remove a cached model
#   ./minillm build                             Build/rebuild engine
#   ./minillm install [path]                    Install to system
#   ./minillm status                            Show system status
#   ./minillm help                              Show help
#
# Environment:
#   MINILLM_PORT       Server port (default: 8080)
#   MINILLM_CACHE      Cache directory (default: ~/.cache/minillm)
#   CC                 C compiler (default: gcc)
#
# New features over original:
#   - Fixed tokenizer: loads real vocab from GGUF for readable output
#   - Single-file bash distribution (engine auto-builds from embedded source)
#   - Model download manager with HuggingFace presets
#   - Interactive chat mode with context
#   - Auto platform detection & SIMD optimization
#   - Dependency auto-install (apt/pkg/brew/pacman)
#   - Colored output with progress indicators
#   - Model list, remove, and demo download
#   - Install to system path
#   - Configurable server port
#   - Works on Linux, macOS, Termux (ARMv7/ARM64/x86_64)
# =============================================================================

set -euo pipefail

# ---- Configuration ----------------------------------------------------------

SCRIPT_NAME="$(basename "$0")"
VERSION="0.4.0"
CACHE_DIR="${MINILLM_CACHE:-${HOME}/.cache/minillm}"
SOURCE_C="${CACHE_DIR}/src/mini-llm.c"
BINARY="${CACHE_DIR}/minillm"
MODELS_DIR="${CACHE_DIR}/models"
BUILD_DIR="${CACHE_DIR}/src"
PORT="${MINILLM_PORT:-8080}"
API_URL="${MINILLM_API_URL:-}"
API_KEY="${MINILLM_API_KEY:-}"

# ---- Colors ----------------------------------------------------------------

if [ -t 1 ]; then
    RED='\033[0;31m';    GREEN='\033[0;32m'
    YELLOW='\033[1;33m'; BLUE='\033[0;34m'
    CYAN='\033[0;36m';   BOLD='\033[1m'
    NC='\033[0m'
else
    RED=''; GREEN=''; YELLOW=''; BLUE=''; CYAN=''; BOLD=''; NC=''
fi

info()  { printf "${GREEN}[*]${NC} %s\n" "$*"; }
warn()  { printf "${YELLOW}[!]${NC} %s\n" "$*"; }
error() { printf "${RED}[x]${NC} %s\n" "$*" >&2; }
header(){ printf "\n${BLUE}=== %s ===${NC}\n" "$*"; }
ok()    { printf "${GREEN}[+]${NC} %s\n" "$*"; }

