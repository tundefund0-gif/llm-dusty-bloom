int main(int argc, char **argv) {
    fprintf(stderr, "mini-llm v0.4.0 - Single file LLM inference\n");
    fprintf(stderr, "Build: %s %s\n", __DATE__, __TIME__);
#if HAS_NEON
    fprintf(stderr, "SIMD: ARM NEON enabled\n");
#else
    fprintf(stderr, "SIMD: none (scalar)\n");
#endif

    if (argc < 2) {
        fprintf(stderr, "\nUsage: %s model.gguf [prompt] [--temp N] [--max-tokens N]\n", argv[0]);
        fprintf(stderr, "  API: curl http://localhost:8080/api/generate -d '{\"prompt\":\"Hello\"}'\n");
        return 1;
    }

    char *model_path = argv[1];
    char *prompt = NULL;
    float temp = 0.8f;
    int max_tokens = 128;

    for (int i = 2; i < argc; i++) {
        if (strcmp(argv[i], "--temp") == 0 && i + 1 < argc) {
            temp = (float)atof(argv[++i]);
        } else if (strcmp(argv[i], "--max-tokens") == 0 && i + 1 < argc) {
            max_tokens = atoi(argv[++i]);
        } else if (!prompt) {
            prompt = argv[i];
        }
    }

    fprintf(stderr, "\nLoading: %s\n", model_path);
    gguf_file_t gf = gguf_open(model_path);

    model_t model = load_model(&gf);
    tokenizer_t tok = load_vocab(&gf);
    g_model = &model;
    g_tok = &tok;

    if (prompt) {
        char *output = calloc(65536, 1);
        fprintf(stderr, "\nPrompt: %s\n", prompt);
        fprintf(stderr, "Generating (temp=%.2f, max_tokens=%d)...\n\n", temp, max_tokens);
        generate(g_model, g_tok, prompt, output, 65536, max_tokens, temp);
        fprintf(stderr, "\n");
        printf("%s", output);
        fflush(stdout);
        free(output);
    } else {
        pthread_t tid;
        pthread_create(&tid, NULL, server_thread, NULL);
        pthread_join(tid, NULL);
    }

    return 0;
}
CCODE

    chmod 644 "$SOURCE_C"
    ok "Source extracted to $SOURCE_C"
}

build_engine() {
    header "Building Inference Engine"
    mkdir -p "$BUILD_DIR"

    local cc="${CC:-gcc}"
    local cflags="-O3 -Wall -Wno-unused-result"
    local ldflags="-lm -lpthread"

    detect_platform

    case "$ARCH" in
        armv7l)
            local float_abi="hard"
            if [ -n "${TERMUX_VERSION:-}" ] || [ "$(uname -o 2>/dev/null)" = "Android" ]; then
                float_abi="softfp"
            fi
            cflags="$cflags -march=armv7-a -mfpu=neon -mfloat-abi=${float_abi}"
            info "ARMv7 with NEON (${float_abi})"
            ;;
        aarch64)
            cflags="$cflags -march=armv8-a"
            info "ARM64 with NEON"
            ;;
    esac

    info "Compiling with: $cc $cflags"
    $cc $cflags -o "$BINARY" "$SOURCE_C" $ldflags

    if [ -x "$BINARY" ]; then
        local size
        size=$(stat -c%s "$BINARY" 2>/dev/null || stat -f%z "$BINARY" 2>/dev/null || echo "0")
        ok "Engine built: $BINARY ($(( size / 1024 )) KB)"
    else
        error "Build failed!"
        exit 1
    fi
}

ensure_engine() {
    if [ ! -x "$BINARY" ]; then
        extract_source
        build_engine
    fi
}

# ---- Model Download --------------------------------------------------------

download_model() {
    local url="$1"
    local name="${2:-}"

    mkdir -p "$MODELS_DIR"

    if [ -z "$name" ]; then
        name="$(basename "$url")"
        name="${name%%\?*}"
    fi

    local dest="$MODELS_DIR/$name"

    if [ -f "$dest" ]; then
        local size
        size=$(stat -c%s "$dest" 2>/dev/null || stat -f%z "$dest" 2>/dev/null || echo "0")
        size=$(( size / 1024 / 1024 ))
        warn "Model already exists: $name (${size}MB)"
        return 0
    fi

    header "Downloading Model"
    info "URL:  $url"
    info "Dest: $dest"

    if curl -L --progress-bar -o "$dest" "$url"; then
        local size
        size=$(stat -c%s "$dest" 2>/dev/null || stat -f%z "$dest" 2>/dev/null || echo "0")
        size=$(( size / 1024 / 1024 ))
        ok "Download complete: ${name} (${size}MB)"
    else
        error "Download failed!"
        rm -f "$dest"
        exit 1
    fi
}

# ---- Model List -----------------------------------------------------------

list_models() {
    header "Cached Models"
    if [ -d "$MODELS_DIR" ] && [ "$(ls -A "$MODELS_DIR" 2>/dev/null)" ]; then
        printf "${BOLD}%-40s %s${NC}\n" "NAME" "SIZE"
        for f in "$MODELS_DIR"/*; do
            local name size
            name="$(basename "$f")"
            size=$(stat -c%s "$f" 2>/dev/null || stat -f%z "$f" 2>/dev/null || echo "0")
